# These checks run after the original smoke checks.
check(if_ir "def choose(x) if x then 10 else 20;" 0 "phi double")
check(if_nested_ir "def choose(x) if x then (if x<2 then 1 else 2) else 3;" 0 "phi double")
check(if_missing_then "if 1 10 else 20;" 1 "Expected 'then'")
check(if_missing_else "if 1 then 10;" 1 "Expected 'else'")
check(if_missing_condition "if then 10 else 20;" 1 "expecting an expression")
check(if_missing_true "if 1 then else 20;" 1 "expecting an expression")
check(if_missing_false "if 1 then 10 else;" 1 "expecting an expression")
check(if_unknown_true "if 1 then unknown else 20;" 1 "Unknown variable")
check(if_unknown_false "if 1 then 10 else unknown;" 1 "Unknown variable")
check(unary_minus "-5 + 2;" 0 "ret double -3.000000e+00")
check(unary_parentheses "-(2+3);" 0 "ret double -5.000000e+00")
check(underscore_call "def my_func(_value2) -_value2; my_func(3);" 0 "call double @my_func")

# Check actual values, not only the shape of the generated IR.
function(check_runtime name source expected)
    set(input "${TEST_DIR}/${name}.toy")
    set(ir "${TEST_DIR}/${name}.ll")
    set(bitcode "${TEST_DIR}/${name}.bc")
    file(WRITE "${input}" "${source}")
    execute_process(COMMAND "${COMPILER}" "${input}" -o "${ir}"
        RESULT_VARIABLE status ERROR_VARIABLE error TIMEOUT 10)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${name} did not compile: ${error}")
    endif()

    # Return exit code 0 if result() gives the expected double.
    file(APPEND "${ir}" "\ndefine i32 @main() {\n  %value = call double @result()\n  %ok = fcmp oeq double %value, ${expected}\n  %status = select i1 %ok, i32 0, i32 1\n  ret i32 %status\n}\n")
    execute_process(COMMAND "${assembler}" "${ir}" -o "${bitcode}"
        RESULT_VARIABLE status ERROR_VARIABLE error TIMEOUT 10)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${name} has invalid LLVM IR: ${error}")
    endif()
    execute_process(COMMAND "${lli}" "${bitcode}"
        RESULT_VARIABLE status ERROR_VARIABLE error TIMEOUT 10)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${name}: wrong result or execution failure (${status}): ${error}")
    endif()
endfunction()

if(lli AND EXISTS "${assembler}")
    check_runtime(if_true "def result() if 1 then 10 else 20;" "1.000000e+01")
    check_runtime(if_false "def result() if 0 then 10 else 20;" "2.000000e+01")
    check_runtime(if_negative "def result() if -2 then 10 else 20;" "1.000000e+01")
    check_runtime(if_nan "def result() if (0/0) then 10 else 20;" "2.000000e+01")
    check_runtime(nested_true "def pick(x) if x then (if x<3 then 10 else 11) else 20; def result() pick(2);" "1.000000e+01")
    check_runtime(nested_false "def pick(x) if x then 10 else (if x<3 then 20 else 21); def result() pick(0);" "2.000000e+01")
    check_runtime(nested_condition "def pick(x) if (if x then 0 else 1) then 10 else 20; def result() pick(0);" "1.000000e+01")
    check_runtime(if_in_call "def add(a b) a+b; def result() add(if 1 then 2 else 3, if 0 then 4 else 5);" "7.000000e+00")
    check_runtime(if_in_arithmetic "def result() 2*(if 1 then 3 else 4)+1;" "7.000000e+00")
    check_runtime(if_lazy_true "def forever() forever(); def result() if 1 then 7 else forever();" "7.000000e+00")
    check_runtime(if_lazy_false "def forever() forever(); def result() if 0 then forever() else 7;" "7.000000e+00")
    check_runtime(fib "def fib(x) if x<3 then 1 else fib(x-1)+fib(x-2); def result() fib(20);" "6.765000e+03")
    message(STATUS "Conditional execution checks passed, including fib(20) = 6765")
endif()
