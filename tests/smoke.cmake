file(MAKE_DIRECTORY "${TEST_DIR}")
function(check name source expected_status expected_text)
    set(input "${TEST_DIR}/${name}.toy")
    file(WRITE "${input}" "${source}")
    execute_process(COMMAND "${COMPILER}" "${input}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected_status EQUAL 0)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "${name} failed: ${error}")
        endif()
        set(actual "${output}")
    else()
        if(status EQUAL 0)
            message(FATAL_ERROR "${name} unexpectedly succeeded")
        endif()
        set(actual "${error}")
    endif()
    string(FIND "${actual}" "${expected_text}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "${name}: missing '${expected_text}' in: ${actual}")
    endif()
endfunction()

check(precedence "2 + 3 * 4;" 0 "ret double 1.400000e+01")
check(parentheses "(2 + 3) * 4;" 0 "ret double 2.000000e+01")
check(associativity "20 - 5 - 3;" 0 "ret double 1.200000e+01")
check(division "24 / 3 / 2;" 0 "ret double 4.000000e+00")
check(compare "2 < 3;" 0 "ret double 1.000000e+00")
check(calls "def add(a b) a+b; add(2,3);" 0 "call double @add")
check(extern_names "extern f(old); def f(new) new*2;" 0 "fmul double %new")
check(recursion "def f(x) f(x);" 0 "call double @f")
check(empty_args "def f() 2; f();" 0 "call double @f()")
check(comments "# comment\n2 + 3; # end" 0 "ret double 5.000000e+00")
check(multiple "2; 3;" 0 "@__anon_expr1")
check(syntax "2 + ;" 1 "expecting an expression")
check(paren "(2+3;" 1 "Expected ')'")
check(number "1.2.3;" 1 "Invalid number")
check(dot ".;" 1 "Invalid number")
check(variable "def f(x) y;" 1 "Unknown variable")
check(arity "def f(x) x; f(1,2);" 1 "Wrong number")
check(unknown "missing(1);" 1 "Unknown function")
check(duplicate "def f(x x) x;" 1 "Duplicate parameter")
check(redefine "def f(x) x; def f(x) x+1;" 1 "already defined")
check(conflict "extern f(x); extern f(x y);" 1 "Conflicting declaration")
check(comma "def f(x,y) x;" 1 "parameters use spaces")

file(WRITE "${TEST_DIR}/tokens.toy" "23 + x")
execute_process(COMMAND "${COMPILER}" --tokens "${TEST_DIR}/tokens.toy"
    RESULT_VARIABLE status OUTPUT_VARIABLE output)
if(NOT status EQUAL 0 OR NOT output MATCHES "number 23\n'\\+'\nidentifier x\neof")
    message(FATAL_ERROR "Token mode failed: ${output}")
endif()
execute_process(COMMAND "${COMPILER}" "${TEST_DIR}/calls.toy" -o "${TEST_DIR}/calls.ll"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT output STREQUAL "" OR NOT EXISTS "${TEST_DIR}/calls.ll")
    message(FATAL_ERROR "Output file mode failed: ${error}")
endif()
message(STATUS "All compiler smoke checks passed")

check(swapped_names "extern f(a b); def f(b a) b-a;" 0 "fsub double %b, %a")
file(WRITE "${TEST_DIR}/same.toy" "2+3;")
execute_process(COMMAND "${COMPILER}" "${TEST_DIR}/same.toy" -o "${TEST_DIR}/same.toy"
    RESULT_VARIABLE status ERROR_VARIABLE error)
file(READ "${TEST_DIR}/same.toy" source)
if(status EQUAL 0 OR NOT source STREQUAL "2+3;")
    message(FATAL_ERROR "Source overwrite protection failed")
endif()

# When LLVM's tools are available, validate and execute generated IR too.
if(EXISTS "${LLVM_TEST_TOOLS}/lli.exe")
    set(lli "${LLVM_TEST_TOOLS}/lli.exe")
    set(assembler "${LLVM_TEST_TOOLS}/llvm-as.exe")
elseif(EXISTS "${LLVM_TEST_TOOLS}/lli")
    set(lli "${LLVM_TEST_TOOLS}/lli")
    set(assembler "${LLVM_TEST_TOOLS}/llvm-as")
endif()
if(lli AND EXISTS "${assembler}")
    file(WRITE "${TEST_DIR}/execute.toy" "def add(a b) a+b; def calculate() add(2,3*4);")
    execute_process(COMMAND "${COMPILER}" "${TEST_DIR}/execute.toy" -o "${TEST_DIR}/execute.ll"
        RESULT_VARIABLE status ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Execution fixture failed to compile: ${error}")
    endif()
    # A native i32 main checks the toy function's double result.
    file(APPEND "${TEST_DIR}/execute.ll" "\ndefine i32 @main() {\n  %value = call double @calculate()\n  %ok = fcmp oeq double %value, 1.400000e+01\n  %status = select i1 %ok, i32 0, i32 1\n  ret i32 %status\n}\n")
    execute_process(COMMAND "${assembler}" "${TEST_DIR}/execute.ll" -o "${TEST_DIR}/execute.bc"
        RESULT_VARIABLE status ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "LLVM assembler rejected IR: ${error}")
    endif()
    execute_process(COMMAND "${lli}" "${TEST_DIR}/execute.bc"
        RESULT_VARIABLE status ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Generated program did not return 14: ${error} (status ${status})")
    endif()
    message(STATUS "LLVM assembled and executed the generated program: result = 14")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/conditionals.cmake")
